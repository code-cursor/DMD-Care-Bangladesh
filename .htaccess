<FilesMatch "(^\.env($|\.)|^requirements\.txt$|^passenger_wsgi\.py$|\.(sqlite3|py|pyc|log)$)">
    Require all denied
</FilesMatch>

Options -Indexes -MultiViews

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect visible /index.html to the domain root.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # Redirect visible .html/.php page URLs to extensionless URLs.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

    # The admin clean URL should use the PHP admin panel, not admin.html.
    RewriteRule ^admin/?$ admin.php [L,QSA]

    # Serve extensionless URLs from matching .html or .php files.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^(all_patient_stories\.html|all_patient_stories\.js|patient-story-list-data\.js)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
